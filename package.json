{
  "name": "openmailbox",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "license": "MPL-2.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "core:android": "tools/build-core.sh android",
    "core:ios": "tools/build-core.sh ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "release": "release-it",
    "core:android:dev": "tools/build-core.sh android --test-ca",
    "core:ios:dev": "tools/build-core.sh ios --test-ca",
    "mail:start": "tools/mail-server/mail-server.sh start",
    "mail:seed": "tools/mail-server/mail-server.sh seed",
    "mail:stop": "tools/mail-server/mail-server.sh stop",
    "mail:performance": "tools/mail-server/mail-server.sh performance",
    "benchmark:store": "cd core && cargo run --release -p mail-store --example benchmark --",
    "benchmark:sync": "cd core && OPENMAILBOX_TEST_CA=\"$(cat ../tools/mail-server/.certificates/ca.pem)\" cargo run --release -p mail-sync --features test-ca --example sync_benchmark --",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.6",
    "@expo/ui": "57.0.9",
    "@openmailbox/mail-core": "link:./modules/mail-core",
    "@shopify/flash-list": "2.3.3",
    "@tanstack/react-query": "^5.107.1",
    "@ubjs/core": "0.31.0-6",
    "dayjs": "^1.11.20",
    "expo": "^57.0.0",
    "expo-background-task": "~57.0.0",
    "expo-constants": "~57.0.6",
    "expo-contacts": "~57.0.0",
    "expo-dev-client": "~57.0.9",
    "expo-document-picker": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.0",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.0",
    "expo-intent-launcher": "~57.0.0",
    "expo-linking": "~57.0.3",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.0",
    "expo-router": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.0",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.0",
    "i18next": "^26.3.1",
    "lucide-react-native": "^1.25.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.8",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "15.0.0",
    "react-native-worklets": "0.10.0",
    "uniffi-bindgen-react-native": "0.31.0-6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.0",
    "@release-it/bumper": "^7.0.5",
    "@release-it/conventional-changelog": "^10.0.6",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.2",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.2.3",
    "release-it": "^19.2.4",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@openmailbox/mail-core$": "<rootDir>/modules/mail-core/src/generated/mail_ffi.ts",
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/core/",
      "<rootDir>/android/",
      "<rootDir>/ios/",
      "<rootDir>/__tests__/helpers/"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@shopify/flash-list))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "packageManager": "yarn@4.5.3"
}
